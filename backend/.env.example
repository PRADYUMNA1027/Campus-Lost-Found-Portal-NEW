# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# Local SQLite database
DATABASE_URL=sqlite:///./campus_lost_found.db

# For PostgreSQL, use something like:
# DATABASE_URL=postgresql://username:password@localhost:5432/campus_lost_found


# ==========================================
# JWT AUTHENTICATION
# ==========================================

JWT_SECRET=super_secret_jwt_key_campus_lost_found_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ==========================================
# AWS S3 STORAGE
# ==========================================

# Leave empty to use local ./uploads storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=campus-lost-found-images


# ==========================================
# EMAIL NOTIFICATIONS
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=noreply@campus.edu


# ==========================================
# GOOGLE SSO / OAUTH
# ==========================================

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback